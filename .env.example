DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PORT=4000
FRONTEND_URL=http://127.0.0.1:5173
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=replace-with-demo-password
DEMO_STAFF_PASSWORD=replace-with-staff-password
NODE_ENV=development
# For separately hosted HTTPS frontend/API: NODE_ENV=production and
# SESSION_COOKIE_SAME_SITE=none. Local HTTP defaults to strict.
